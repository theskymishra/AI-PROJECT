# AI-DERS backend configuration.
# Copy to .env and edit. All values have safe defaults; nothing here is required.

# Interface uvicorn binds to.
AIDERS_HOST=127.0.0.1
AIDERS_PORT=8000

# Comma-separated list of browser origins allowed by CORS.
# Must include the Vite dev server origin.
AIDERS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Master seed. Every random draw in the simulation derives from this
# (see Phase 0 section 3). Changing it changes the scenario; keeping it
# fixed guarantees byte-identical reruns.
AIDERS_SEED=20260828
