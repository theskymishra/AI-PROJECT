# AI-DERS frontend configuration.
# Copy this file to .env before running `npm run dev`.
#
#   macOS / Linux:  cp .env.example .env
#   Windows (cmd):  copy .env.example .env
#   Windows (PS):   Copy-Item .env.example .env
#
# Base URL of the FastAPI backend. Must match the host and port uvicorn is
# bound to, and this origin must appear in the backend's AIDERS_CORS_ORIGINS.
VITE_API_URL=http://localhost:8000
